{
    "customizations": {
        "vscode": {
            "settings": {
                "python.envFile": "${workspaceFolder}/.env",
                "terminal.integrated.profiles.linux": {
                    "bash": {
                        "path": "/usr/bin/bash",
                        "icon": "terminal-bash",
                        "args": [
                            "--init-file",
                            ".env"
                        ]
                    }
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
